# PUBLIC REPOSITORY: never commit secrets, credentials, member data or paid resources.

# environment / secrets
.env
.env.local
.env.*
!.env.example
*.pem
*.key
secrets/

# dependencies
node_modules/

# build output
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.vercel/
.wrangler/

# test output
test-results/
playwright-report/
blob-report/
coverage/

# temporary files
tmp/
temp/
.cache/
*.tmp
*.log
npm-debug.log*

# local backups and member-state exports
*.bak
*.backup
*.orig
backups/
og056-progress-*.json

# private or paid resources: never commit (the repository is public)
private/
public/resources/private/

# Real member content, kept out of this PUBLIC repository but still built and deployed.
#
# The build loads every .json in data/resources, so a "*.private.json" record is picked up locally and by a
# Direct Upload deployment, while never being committed here. Its download lives in public/resources and is
# ignored for the same reason. This is what lets the private preview serve real resources from a public repo
# without ever publishing them (Stage 9.7 owner ruling).
data/resources/*.private.json

# Real member downloads live OUTSIDE public/, because public/ is copied wholesale into every build. They are
# staged into public/resources only by `npm run build:preview`, and removed again afterwards, so a plain
# production build cannot pick them up even by accident.
private-assets/
public/resources/*.pdf
public/resources/*.xlsx
public/resources/*.docx
public/resources/*.zip

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# importer working data: local paths and unreleased content (owner decision D9-4)
workspace/

