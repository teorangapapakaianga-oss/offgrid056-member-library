{
    "name":  "offgrid056-member-library",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --port 3800",
                    "validate":  "tsx tools/validate-content.ts",
                    "prebuild":  "npm run validate",
                    "build":  "next build",
                    "postbuild":  "node tools/flatten-segment-prefetch.mjs",
                    "serve":  "npx --yes serve@14 out -l 3801",
                    "lint":  "eslint",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "import:scan":  "tsx admin-import/cli.mts scan",
                    "import:admin":  "tsx admin-import/ui/server.mts",
                    "import:apply":  "tsx admin-import/cli.mts apply",
                    "import:audit":  "tsx admin-import/cli.mts audit",
                    "import:reskin":  "tsx admin-import/cli.mts reskin",
                    "import:pilot":  "tsx admin-import/cli.mts pilot",
                    "import:readiness":  "tsx admin-import/cli.mts readiness",
                    "build:preview":  "node tools/build-preview.mjs",
                    "import:prep":  "tsx admin-import/cli.mts prep"
                },
    "dependencies":  {
                         "minisearch":  "7.2.0",
                         "next":  "16.3.5",
                         "react":  "19.2.8",
                         "react-dom":  "19.2.8",
                         "zod":  "4.6.5"
                     },
    "devDependencies":  {
                            "@playwright/test":  "1.63.0",
                            "@tailwindcss/postcss":  "4.3.3",
                            "@types/adm-zip":  "^0.5.8",
                            "@types/node":  "24.13.6",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "adm-zip":  "^0.6.1",
                            "eslint":  "9.39.5",
                            "eslint-config-next":  "16.3.5",
                            "pdf-parse":  "^2.4.5",
                            "tailwindcss":  "4.3.3",
                            "tsx":  "4.23.13",
                            "typescript":  "5.9.3",
                            "vitest":  "5.0.1",
                            "wrangler":  "4.135.0"
                        }
}